{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cigar-catalogue",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "kv_namespaces": [
    {
      "binding": "CATALOGUE_STATE",
      "id": "e7a1c5222f594ebbaee4a80eb68817d6"
    }
  ],
  "triggers": {
    "crons": ["15 2 * * *", "45 2 * * SUN"]
  }
}
